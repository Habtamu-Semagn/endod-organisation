# Copy to deploy/.env and fill in. Never commit the filled-in file.

# --- This service's own Postgres (the postgres service in docker-compose.yml) ---
# Three roles (deploy/postgres-init/10-roles.sh creates the last two when the
# volume is first created):
#   postgres   the superuser: the init script and emergencies only
#   org_owner  owns the schema; only the one-shot `migrate` service uses it
#   org_app    the API: no DDL; audit_events is SELECT/INSERT only
POSTGRES_PASSWORD=change-me-superuser
ORG_OWNER_PASSWORD=change-me-owner
ORG_APP_PASSWORD=change-me-app
# Each URL repeats its role's password.
ORG_MIGRATE_DATABASE_URL=postgresql+psycopg://org_owner:change-me-owner@postgres:5432/organisation
ORG_DATABASE_URL=postgresql+psycopg://org_app:change-me-app@postgres:5432/organisation

# At least 32 random characters each, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# SESSION_SECRET keys session and setup-link hashes and encrypts TOTP secrets:
# changing it signs everyone out and voids every authenticator (run reset-2fa for each admin).
SESSION_SECRET=
# Shared by the web app and the API (sent as X-BFF-Secret); the API refuses
# every request without it, except /health.
BFF_SHARED_SECRET=

# The public origin: setup links point here and the web app accepts changes only from it.
# With https here, the web app also insists on nginx's X-Endod-Client-IP header (503 without it).
SITE_ORIGIN=https://organisation.endod-health.com

# Optional.
# SHARED_NGINX_NETWORK=eyita_edge
